  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">BlindersCalloutsUI – label callouts</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float textSize = 140 {"hint":"Shelf-label callout text size (Text.size). 140 gives capitals about 1.9 cm tall", "widget":"slider", "min":60, "max":300, "step":5}'
    - '// @input float boxTextSize = 115 {"hint":"Box-label callout text size (Text.size). 115 gives capitals about 1.6 cm tall", "widget":"slider", "min":60, "max":300, "step":5}'
    - '// @input float shelfWrapWidthCm = 72 {"hint":"Wrap width of shelf-label callouts in cm (3 lines max)", "widget":"slider", "min":15, "max":100, "step":1}'
    - '// @input float boxWrapWidthCm = 34 {"hint":"Wrap width of box-label callouts in cm (keeps neighbours apart)", "widget":"slider", "min":15, "max":60, "step":1}'
    - '// @input float standOffCm = 1.5 {"hint":"How far in front of the label the callout floats (cm)", "widget":"slider", "min":0, "max":15, "step":0.5}'
    - '// @input float liftCm = 2.5 {"hint":"Gap between the top of the label and the bottom of the callout (cm)", "widget":"slider", "min":0, "max":10, "step":0.5}'
    - '// @input float fadeDurationSec = 0.8 {"hint":"Fade-out duration once a shelf is no longer looked at (s)", "widget":"slider", "min":0.1, "max":3, "step":0.1}'
    - '// @input float contrastStyle = 2 {"hint":"Contrast aid. Dark renders transparent on the glasses, so this only helps the preview and video", "widget":"combobox", "values":[{"label":"None", "value":0}, {"label":"Halo (outline + shadow)", "value":1}, {"label":"Backing (dark plate)", "value":2}]}'
    - '// @input float contrastOpacity = 0.7 {"hint":"Opacity of the dark halo / backing", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input Asset.Material lineMaterial {"hint":"Unlit material for the leader line from label to callout (cloned per callout)"}'
    - '// @input vec4 redColor = "{1,0.48,0.45,1}" {"hint":"Red: wrong shelf, expired, empty", "widget":"color"}'
    - '// @input vec4 amberColor = "{1,0.8,0.32,1}" {"hint":"Amber: expiring soon, ERP action, count mismatch", "widget":"color"}'
    - '// @input vec4 greyColor = "{0.8,0.8,0.82,1}" {"hint":"Grey: unknown code ?", "widget":"color"}'
    - '// @input vec4 infoColor = "{0.95,0.97,1,1}" {"hint":"Info text (mode 2 details)", "widget":"color"}'
    - '// @input vec4 okDotColor = "{0.4,1,0.55,1}" {"hint":"Green dot for labels that match the ERP", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
