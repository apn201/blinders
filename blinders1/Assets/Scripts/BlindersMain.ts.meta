  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">BlindersMain – shelf check + camera pause</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - "// @input SceneObject cameraObject {\"hint\":\"The world camera (operator's head)\"}"
    - '// @input AssignableType_1 rackA {"hint":"Rack A builder"}'
    - '// @input AssignableType_2 rackB {"hint":"Rack B builder"}'
    - '// @input AssignableType_3 person {"hint":"Stand-in person"}'
    - '// @input AssignableType_4 callouts {"hint":"Callouts view"}'
    - '// @input AssignableType_5 pausePill {"hint":"Camera paused pill view"}'
    - '// @input AssignableType_6 modeMenu {"hint":"Mode menu view"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float startMode = 1 {"hint":"Mode at Lens start: 0 normal glasses, 1 problems only, 2 everything", "widget":"combobox", "values":[{"label":"0 - Off", "value":0}, {"label":"1 - Problems only", "value":1}, {"label":"2 - Everything", "value":2}]}'
    - '// @input float readRangeCm = 250 {"hint":"Labels further than this are not read (cm)", "widget":"slider", "min":100, "max":500, "step":10}'
    - '// @input float mode2ViewConeDeg = 30 {"hint":"Mode 2: shelves whose centre is within this angle of the view centre are read (deg)", "widget":"slider", "min":5, "max":45, "step":1}'
    - "// @input float fadeAfterSec = 5 {\"hint\":\"A shelf's callouts fade this long after you stop looking at it (s)\", \"widget\":\"slider\", \"min\":1, \"max\":15, \"step\":0.5}"
    - '// @input float recheckIntervalSec = 5 {"hint":"While paused, one test frame is taken this often (s)", "widget":"slider", "min":1, "max":15, "step":0.5}'
    - "// @input float personDetectHalfAngleDeg = 30 {\"hint\":\"Person counts as 'in view' inside this half-angle of the view centre (deg)\", \"widget\":\"slider\", \"min\":10, \"max\":50, \"step\":1}"
    - "// @input float lookDownPitchDeg = 60 {\"hint\":\"Head pitch below the horizon that counts as 'looking down' (deg)\", \"widget\":\"slider\", \"min\":20, \"max\":80, \"step\":1}"
    - '// @input float lookDownHoldSec = 2 {"hint":"Seconds of looking down to open the mode menu", "widget":"slider", "min":1, "max":8, "step":0.5}'
    - '// @input float dwellSec = 1.5 {"hint":"Gaze dwell needed to pick a menu item (s)", "widget":"slider", "min":0.5, "max":4, "step":0.1}'
    - '// @input float menuLookAwaySec = 3 {"hint":"Menu closes after looking away from it this long (s)", "widget":"slider", "min":1, "max":8, "step":0.5}'
    - '// @input float sfxVolume = 0.6 {"hint":"Cue volume (mode select, camera pause)", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
